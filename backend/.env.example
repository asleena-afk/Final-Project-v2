SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...). A legacy anon key also works.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Direct connection, or the session pooler if your host has no IPv6.
DATABASE_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
# Optional: only these emails can create projects (comma separated). Leave empty to allow any signed-in user.
PM_EMAILS=
# Invitations: lets a PM invite people who have no account yet. Keep this secret (Supabase > Project Settings > API keys, "service_role" / secret key).
SUPABASE_SERVICE_ROLE_KEY=
# Where the invitation link opens (your frontend address).
APP_URL=http://localhost:5173
